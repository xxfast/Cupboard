<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUiApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Cupboard">

    <Grid Padding="16" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Navigator: the shared outline, collapse rules already applied. -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Undo" Command="{x:Bind ViewModel.UndoCommand}" />
                <Button Content="Redo" Command="{x:Bind ViewModel.RedoCommand}" />
            </StackPanel>

            <ListView x:Name="OutlineList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Outline}"
                      SelectionMode="Single"
                      SelectionChanged="OutlineList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Nesting shown as a spacer: Indent is a double, and
                                 Margin would need a Thickness converter. -->
                            <Border Width="{Binding Indent}" />
                            <TextBlock Text="{Binding SlideNumber}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Canvas placeholder. The slide surface is not ported to WinUI yet: the
             Kotlin core carries no renderer for this platform, by design. -->
        <Border Grid.Column="1"
                Background="#17181C"
                CornerRadius="8">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.SelectedSlideTitle, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Canvas not implemented on Windows yet"
                           HorizontalAlignment="Center"
                           Foreground="#8A8F98"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
